# Copy to .env.local for local dev; set the same keys in Vercel → Project → Settings → Environment Variables.

# Canonical URL (used for sitemap, canonical tags, JSON-LD, share images)
NEXT_PUBLIC_SITE_URL=https://www.aromeosayi.org

# Show the dashed "To confirm" markers. Set to false for production once items are resolved.
NEXT_PUBLIC_SHOW_PENDING=true

# Supabase (forms + itinerary). Without these, local dev writes forms to .data/submissions.ndjson
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Resend (form notifications + auto-replies). Optional; submissions are saved either way.
RESEND_API_KEY=
EMAIL_FROM="Office of Apostle Arome Osayi <noreply@aromeosayi.org>"
TEAM_INBOX=info@aromeosayi.org
# Optional per-form inboxes (fall back to TEAM_INBOX)
INBOX_INVITATIONS=
INBOX_PRAYER=
INBOX_CONTACT=
INBOX_PARTNERS=
INBOX_TESTIMONIES=
INBOX_NEWSLETTER=

# Cloudflare Turnstile (optional spam check, on top of honeypot + timing)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
